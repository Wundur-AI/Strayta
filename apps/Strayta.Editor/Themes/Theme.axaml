        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Dense, quiet defaults for a tool UI -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource St.Window}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource St.TextMuted}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource St.TextMuted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="FlyoutPresenter">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button:not(.icon)">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource St.TextMuted}" />
    <Setter Property="LetterSpacing" Value="0.4" />
  </Style>

  <!-- Dragging a tab or panel shows a translucent accent rectangle the size of what is being moved,
       instead of a live copy of its contents. -->
  <Style Selector="dockc|DragPreviewWindow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TransparencyLevelHint" Value="Transparent" />
  </Style>
  <Style Selector="dockc|DragPreviewControl">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Width="{TemplateBinding PreviewContentWidth}" Height="{TemplateBinding PreviewContentHeight}"
                MinWidth="160" MinHeight="100" CornerRadius="6" BorderThickness="2"
                Background="{DynamicResource St.DragPreviewFill}" BorderBrush="{DynamicResource St.Accent}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Line icons -->
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource St.Text}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Path.icon.small">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="StrokeThickness" Value="1.4" />
  </Style>

  <!-- Borderless icon buttons (toolbars, panel footers) -->
  <Style Selector="Button.icon, ToggleButton.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter, ToggleButton.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource St.Hover}" />
  </Style>
  <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource St.AccentSoft}" />
  </Style>
  <Style Selector="ToggleButton.icon:checked Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource St.Accent}" />
  </Style>
  <!-- Tool slot corner triangle: the slot holds more tools (Controls/ToolSlot.cs) -->
  <Style Selector="Path.slotMore">
    <Setter Property="Fill" Value="{DynamicResource St.TextMuted}" />
    <Setter Property="Width" Value="4" />
    <Setter Property="Height" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,-4,-4" />
  </Style>
  <Style Selector="ToggleButton.icon:checked Path.slotMore">
    <Setter Property="Fill" Value="{DynamicResource St.Accent}" />
  </Style>
  <Style Selector="Button.icon:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon:disabled Path.icon">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- Segmented view switcher -->
  <Style Selector="ToggleButton.segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource St.PanelRaised}" />
  </Style>

  <!-- Compact inputs -->
  <Style Selector="Slider">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0,-12" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
</Styles>
