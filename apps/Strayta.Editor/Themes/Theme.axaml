          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FFD3D3D8" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF1F6FEB" />
          <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="ToolTipForeground" Color="#FF1C1C1F" />
          <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FFD3D3D8" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#FFD3D3D8" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#FFF0F0F3" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#331F6FEB" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#331F6FEB" />
          <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#FF1C1C1F" />
          <SolidColorBrush x:Key="SliderTrackFill" Color="#FFD3D3D8" />
          <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#FFD3D3D8" />
          <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF1F6FEB" />
          <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF1F6FEB" />
