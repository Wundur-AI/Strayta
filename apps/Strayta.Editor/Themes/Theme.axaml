<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dockc="using:Dock.Avalonia.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Strayta/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Design tokens. Custom surfaces use these; Fluent controls get the matching palette in App.axaml. -->
      <!-- Shape and size, shared by both appearances -->
      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
      <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
      <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
      <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
      <Thickness x:Key="ButtonPadding">12,4,12,5</Thickness>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="St.Window" Color="#FF18181A" />
          <SolidColorBrush x:Key="St.Panel" Color="#FF26262A" />
          <SolidColorBrush x:Key="St.PanelRaised" Color="#FF323237" />
          <SolidColorBrush x:Key="St.Canvas" Color="#FF131315" />
          <SolidColorBrush x:Key="St.Border" Color="#FF3D3D43" />
          <SolidColorBrush x:Key="St.RowLine" Color="#FF1E1E21" />
          <SolidColorBrush x:Key="St.RowSelected" Color="#FF3E3E45" />
          <SolidColorBrush x:Key="St.ThumbBackground" Color="#FFE9E9EC" />
          <SolidColorBrush x:Key="St.EyeCell" Color="#FF2D2D32" />
          <SolidColorBrush x:Key="St.DragPreviewFill" Color="#403B82F6" />
          <SolidColorBrush x:Key="St.EyeCellHover" Color="#FF37373D" />
          <SolidColorBrush x:Key="St.Text" Color="#FFE6E6E8" />
          <SolidColorBrush x:Key="St.TextMuted" Color="#FF98989F" />
          <SolidColorBrush x:Key="St.Hover" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="St.Accent" Color="#FF3B82F6" />
          <SolidColorBrush x:Key="St.AccentSoft" Color="#403B82F6" />
          <SolidColorBrush x:Key="St.Warning" Color="#FFE3A945" />
          <Color x:Key="St.CheckerLight">#FF6B6B70</Color>
          <Color x:Key="St.CheckerDark">#FF4E4E53</Color>
          <!-- Dock (panels, tabs, splitters) mapped onto the same tokens -->
          <SolidColorBrush x:Key="DockApplicationAccentBrushLow" Color="#FF2C2C30" />
          <SolidColorBrush x:Key="DockApplicationAccentBrushMed" Color="#FF34343A" />
          <SolidColorBrush x:Key="DockApplicationAccentBrushHigh" Color="#FF3B82F6" />
          <SolidColorBrush x:Key="DockApplicationAccentBrushIndicator" Color="#FF3B82F6" />
          <SolidColorBrush x:Key="DockApplicationAccentForegroundBrush" Color="#FFE6E6E8" />
          <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#FF2C2C30" />
          <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#FF232326" />
          <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#FF232326" />
          <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#FF232326" />
          <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#FF1B1B1D" />
          <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#FF151517" />
          <SolidColorBrush x:Key="DockThemeBackgroundBrush" Color="#FF1B1B1D" />
          <SolidColorBrush x:Key="DockThemeControlBackgroundBrush" Color="#FF232326" />
          <SolidColorBrush x:Key="DockThemeForegroundBrush" Color="#FFE6E6E8" />
          <SolidColorBrush x:Key="DockThemeBorderLowBrush" Color="#FF38383D" />
          <SolidColorBrush x:Key="DockThemeAccentBrush" Color="#FF3B82F6" />
          <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#FF2E2E33" />
          <SolidColorBrush x:Key="DockBorderStrongBrush" Color="#FF38383D" />
          <SolidColorBrush x:Key="DockSeparatorBrush" Color="#FF38383D" />
          <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush" Color="#FF1B1B1D" />
          <SolidColorBrush x:Key="DockDocumentContentBorderBrush" Color="#FF38383D" />
          <SolidColorBrush x:Key="DockTabBackgroundBrush" Color="Transparent" />
          <SolidColorBrush x:Key="DockTabHoverBackgroundBrush" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#FF232326" />
          <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#FF3B82F6" />
          <SolidColorBrush x:Key="DockTabForegroundBrush" Color="#FF98989F" />
          <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#FFE6E6E8" />
          <SolidColorBrush x:Key="DockTabSelectedForegroundBrush" Color="#FFE6E6E8" />
          <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="#FFE6E6E8" />
