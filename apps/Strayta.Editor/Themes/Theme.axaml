          <SolidColorBrush x:Key="DockChromeButtonForegroundBrush" Color="#FF98989F" />
          <SolidColorBrush x:Key="DockToolChromeIconBrush" Color="#FF98989F" />
          <!-- Fluent control resources, so built-in controls follow the tokens -->
