          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF34343A" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF3C3C42" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF3A3A40" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF3A3A40" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF3A3A40" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#FFE6E6E8" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFE6E6E8" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#403B82F6" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#403B82F6" />
          <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFE6E6E8" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFE6E6E8" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF2C2C30" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF34343A" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FF3A3A40" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FF3A3A40" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF2C2C30" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#FF1B1B1D" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF1B1B1D" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF1B1B1D" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FF3A3A40" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF3A3A40" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF3B82F6" />
          <SolidColorBrush x:Key="ToolTipBackground" Color="#FF2C2C30" />
          <SolidColorBrush x:Key="ToolTipForeground" Color="#FFE6E6E8" />
          <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FF3A3A40" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FF2C2C30" />
          <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#FF3A3A40" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FF2C2C30" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#FF34343A" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#403B82F6" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#403B82F6" />
          <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#FFE6E6E8" />
          <SolidColorBrush x:Key="SliderTrackFill" Color="#FF3A3A40" />
          <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#FF3A3A40" />
          <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF3B82F6" />
          <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF3B82F6" />
          <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFE6E6E8" />
          <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFE6E6E8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="St.Window" Color="#FFE4E4E8" />
          <SolidColorBrush x:Key="St.Panel" Color="#FFF4F4F6" />
          <SolidColorBrush x:Key="St.PanelRaised" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="St.Canvas" Color="#FFC5C5CB" />
          <SolidColorBrush x:Key="St.Border" Color="#FFCFCFD5" />
          <SolidColorBrush x:Key="St.RowLine" Color="#FFE3E3E7" />
          <SolidColorBrush x:Key="St.RowSelected" Color="#FFD9E4F7" />
          <SolidColorBrush x:Key="St.ThumbBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="St.EyeCell" Color="#FFEAEAED" />
          <SolidColorBrush x:Key="St.DragPreviewFill" Color="#401F6FEB" />
          <SolidColorBrush x:Key="St.EyeCellHover" Color="#FFDFDFE3" />
          <SolidColorBrush x:Key="St.Text" Color="#FF1C1C1F" />
          <SolidColorBrush x:Key="St.TextMuted" Color="#FF6C6C72" />
          <SolidColorBrush x:Key="St.Hover" Color="#0F000000" />
          <SolidColorBrush x:Key="St.Accent" Color="#FF1F6FEB" />
          <SolidColorBrush x:Key="St.AccentSoft" Color="#331F6FEB" />
          <SolidColorBrush x:Key="St.Warning" Color="#FFB7791F" />
          <Color x:Key="St.CheckerLight">#FFFFFFFF</Color>
          <Color x:Key="St.CheckerDark">#FFD9D9DD</Color>
          <SolidColorBrush x:Key="DockApplicationAccentBrushLow" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="DockApplicationAccentBrushMed" Color="#FFEDEDF0" />
          <SolidColorBrush x:Key="DockApplicationAccentBrushHigh" Color="#FF1F6FEB" />
          <SolidColorBrush x:Key="DockApplicationAccentBrushIndicator" Color="#FF1F6FEB" />
          <SolidColorBrush x:Key="DockApplicationAccentForegroundBrush" Color="#FF1C1C1F" />
          <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#FFF6F6F8" />
          <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#FFF6F6F8" />
          <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#FFF6F6F8" />
          <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#FFE9E9EC" />
          <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#FFC9C9CE" />
          <SolidColorBrush x:Key="DockThemeBackgroundBrush" Color="#FFE9E9EC" />
          <SolidColorBrush x:Key="DockThemeControlBackgroundBrush" Color="#FFF6F6F8" />
          <SolidColorBrush x:Key="DockThemeForegroundBrush" Color="#FF1C1C1F" />
          <SolidColorBrush x:Key="DockThemeBorderLowBrush" Color="#FFD3D3D8" />
          <SolidColorBrush x:Key="DockThemeAccentBrush" Color="#FF1F6FEB" />
          <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#FFE2E2E6" />
          <SolidColorBrush x:Key="DockBorderStrongBrush" Color="#FFD3D3D8" />
          <SolidColorBrush x:Key="DockSeparatorBrush" Color="#FFD3D3D8" />
          <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush" Color="#FFE9E9EC" />
          <SolidColorBrush x:Key="DockDocumentContentBorderBrush" Color="#FFD3D3D8" />
          <SolidColorBrush x:Key="DockTabBackgroundBrush" Color="Transparent" />
          <SolidColorBrush x:Key="DockTabHoverBackgroundBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#FFF6F6F8" />
          <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#FF1F6FEB" />
          <SolidColorBrush x:Key="DockTabForegroundBrush" Color="#FF6C6C72" />
          <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#FF1C1C1F" />
          <SolidColorBrush x:Key="DockTabSelectedForegroundBrush" Color="#FF1C1C1F" />
          <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="#FF1C1C1F" />
          <SolidColorBrush x:Key="DockDocumentTabPointerOverForegroundBrush" Color="#FF1C1C1F" />
          <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush" Color="#FF6C6C72" />
          <SolidColorBrush x:Key="DockDocumentTabClosePointerOverForegroundBrush" Color="#FF1C1C1F" />
          <SolidColorBrush x:Key="DockSplitterIdleBrush" Color="#FFE9E9EC" />
          <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="#FF1F6FEB" />
          <SolidColorBrush x:Key="DockSplitterDragBrush" Color="#FF1F6FEB" />
          <SolidColorBrush x:Key="DockChromeButtonForegroundBrush" Color="#FF6C6C72" />
          <SolidColorBrush x:Key="DockToolChromeIconBrush" Color="#FF6C6C72" />
          <!-- Fluent control resources, so built-in controls follow the tokens -->
          <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFF0F0F3" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFE6E6EA" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFD3D3D8" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFD3D3D8" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFD3D3D8" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#FF1C1C1F" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF1C1C1F" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#331F6FEB" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#331F6FEB" />
          <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FF1C1C1F" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FF1C1C1F" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFF0F0F3" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFD3D3D8" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FFD3D3D8" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
