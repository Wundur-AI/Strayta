<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Strayta.Editor.ViewModels"
        xmlns:c="using:Strayta.Editor.Controls"
        x:Class="Strayta.Editor.Views.FillWindow"
        x:DataType="vm:FillDialogViewModel"
        Title="Fill"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource St.Panel}"
        FontSize="12">
  <!-- Photoshop's Fill dialog: Contents, then Blending (Mode, Opacity, Preserve Transparency). -->
  <Window.Styles>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="ComboBox#ContentsBox ComboBoxItem" x:DataType="vm:FillContentOption">
      <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="*,14,90" Margin="16,14">
    <StackPanel Spacing="12">
      <Border BorderBrush="{DynamicResource St.Border}" BorderThickness="1" CornerRadius="4" Padding="10,8">
        <StackPanel Spacing="8">
          <TextBlock Text="Contents" FontWeight="SemiBold" />
          <ComboBox x:Name="ContentsBox" ItemsSource="{Binding ContentOptions}" SelectedIndex="{Binding ContentsIndex}" Width="190">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FillContentOption">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding UsesColor}">
            <TextBlock Text="Color:" VerticalAlignment="Center" />
            <Button Padding="0" BorderThickness="0" Background="Transparent">
              <Border Width="40" Height="20" CornerRadius="3" BorderBrush="{DynamicResource St.Border}" BorderThickness="1">
                <Border.Background>
                  <SolidColorBrush Color="{Binding CustomColor}" />
                </Border.Background>
              </Border>
              <Button.Flyout>
                <Flyout Placement="Bottom">
                  <ColorView Color="{Binding CustomColor}" IsAlphaVisible="False" Width="300" />
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding UsesPattern}">
            <TextBlock Text="Custom Pattern:" VerticalAlignment="Center" />
            <c:PatternPicker Pattern="{Binding Pattern}" DocumentPatterns="{Binding DocumentPatterns}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border BorderBrush="{DynamicResource St.Border}" BorderThickness="1" CornerRadius="4" Padding="10,8" IsEnabled="{Binding BlendingEnabled}">
        <StackPanel Spacing="8">
          <TextBlock Text="Blending" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Mode:" VerticalAlignment="Center" Width="60" />
            <ComboBox ItemsSource="{x:Static c:PaintModeNames.Names}" SelectedIndex="{Binding ModeIndex}" Width="160" MaxDropDownHeight="500" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Opacity:" VerticalAlignment="Center" Width="60" />
            <c:NumberField Value="{Binding Opacity}" Unit="%" Width="60" />
          </StackPanel>
          <CheckBox Content="Preserve Transparency" IsChecked="{Binding PreserveTransparency}" />
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Grid.Column="2" Spacing="8">
      <Button x:Name="OkButton" Content="OK" IsDefault="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
