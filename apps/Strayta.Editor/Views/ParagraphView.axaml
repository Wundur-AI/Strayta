<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Strayta.Editor.ViewModels"
             xmlns:c="using:Strayta.Editor.Controls"
             x:Class="Strayta.Editor.Views.ParagraphView"
             x:DataType="vm:ParagraphToolViewModel"
             Background="{DynamicResource St.Panel}"
             FontSize="11">
  <UserControl.Styles>
    <Style Selector="c|NumberField">
      <Setter Property="Width" Value="64" />
    </Style>
    <Style Selector="TextBlock.glyph">
      <Setter Property="Width" Value="26" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource St.TextMuted}" />
    </Style>
  </UserControl.Styles>

  <!-- Photoshop's Paragraph panel (TypeOptions.cs): applies to every paragraph the selection touches. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="10,8" Spacing="10" DataContext="{Binding Editor.Type}" x:DataType="vm:TypeOptions">
      <TextBlock Classes="muted" Text="{Binding TargetText}" />
      <WrapPanel>
        <ToggleButton Classes="icon" IsChecked="{Binding AlignLeft}" ToolTip.Tip="Left align text"><Path Classes="icon small" Data="{StaticResource IconAlignLeft}" /></ToggleButton>
        <ToggleButton Classes="icon" IsChecked="{Binding AlignCenter}" ToolTip.Tip="Center text"><Path Classes="icon small" Data="{StaticResource IconAlignCenter}" /></ToggleButton>
        <ToggleButton Classes="icon" IsChecked="{Binding AlignRight}" ToolTip.Tip="Right align text"><Path Classes="icon small" Data="{StaticResource IconAlignRight}" /></ToggleButton>
        <Border Width="8" />
        <ToggleButton Classes="icon" IsChecked="{Binding JustifyLastLeft}" ToolTip.Tip="Justify last left"><Path Classes="icon small" Data="{StaticResource IconJustifyLeft}" /></ToggleButton>
        <ToggleButton Classes="icon" IsChecked="{Binding JustifyLastCenter}" ToolTip.Tip="Justify last centered"><Path Classes="icon small" Data="{StaticResource IconJustifyCenter}" /></ToggleButton>
        <ToggleButton Classes="icon" IsChecked="{Binding JustifyLastRight}" ToolTip.Tip="Justify last right"><Path Classes="icon small" Data="{StaticResource IconJustifyRight}" /></ToggleButton>
        <ToggleButton Classes="icon" IsChecked="{Binding JustifyAll}" ToolTip.Tip="Justify all"><Path Classes="icon small" Data="{StaticResource IconJustifyAll}" /></ToggleButton>
      </WrapPanel>

      <Grid ColumnDefinitions="Auto,Auto,12,Auto,Auto" RowDefinitions="Auto,6,Auto,6,Auto">
        <TextBlock Classes="glyph" Text="→≡" ToolTip.Tip="Indent left margin" />
        <c:NumberField Grid.Column="1" Unit=" pt" Value="{Binding StartIndent}" ToolTip.Tip="Indent left margin" />
        <TextBlock Grid.Column="3" Classes="glyph" Text="≡←" ToolTip.Tip="Indent right margin" />
        <c:NumberField Grid.Column="4" Unit=" pt" Value="{Binding EndIndent}" ToolTip.Tip="Indent right margin" />
        <TextBlock Grid.Row="2" Classes="glyph" Text="→¶" ToolTip.Tip="Indent first line" />
        <c:NumberField Grid.Row="2" Grid.Column="1" Unit=" pt" Value="{Binding FirstLineIndent}" ToolTip.Tip="Indent first line" />
        <TextBlock Grid.Row="4" Classes="glyph" Text="↑¶" ToolTip.Tip="Add space before paragraph" />
        <c:NumberField Grid.Row="4" Grid.Column="1" Unit=" pt" Value="{Binding SpaceBefore}" ToolTip.Tip="Add space before paragraph" />
        <TextBlock Grid.Row="4" Grid.Column="3" Classes="glyph" Text="¶↓" ToolTip.Tip="Add space after paragraph" />
        <c:NumberField Grid.Row="4" Grid.Column="4" Unit=" pt" Value="{Binding SpaceAfter}" ToolTip.Tip="Add space after paragraph" />
      </Grid>

      <CheckBox Content="Hyphenate" IsChecked="{Binding Hyphenate}"
                ToolTip.Tip="Saved with the text for other apps; Strayta's own line breaking does not hyphenate yet" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
