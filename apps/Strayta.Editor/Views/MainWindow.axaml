<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Strayta.Editor.ViewModels"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:c="using:Strayta.Editor.Controls"
        xmlns:v="using:Strayta.Editor.Views"
        x:Class="Strayta.Editor.Views.MainWindow"
        x:DataType="vm:EditorViewModel"
        Title="{Binding WindowTitle}"
        Width="1500" Height="950" MinWidth="900" MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        DragDrop.AllowDrop="True">
  <DockPanel>
    <!-- Title bar with the main toolbar. The window's own buttons (traffic lights on macOS, caption buttons on
         Windows) sit on top of it; empty areas drag the window and double-clicking zooms. -->
    <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="44" Background="{DynamicResource St.PanelRaised}"
            BorderBrush="{DynamicResource St.Border}" BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPressed" DoubleTapped="OnTitleBarDoubleTapped">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel x:Name="TitleLeft" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="84,0,0,0">
          <Button Classes="icon" ToolTip.Tip="New (⌘N)" Command="{Binding NewDocumentCommand}"><Path Classes="icon" Data="{StaticResource IconNew}" /></Button>
          <Button Classes="icon" ToolTip.Tip="Open (⌘O)" Command="{Binding OpenCommand}"><Path Classes="icon" Data="{StaticResource IconOpen}" /></Button>
          <Button Classes="icon" ToolTip.Tip="Save (⌘S)" Command="{Binding SaveCommand}"><Path Classes="icon" Data="{StaticResource IconSave}" /></Button>
          <Border Width="1" Height="18" Margin="8,0" Background="{DynamicResource St.Border}" />
          <Button Classes="icon" ToolTip.Tip="{Binding ActiveDocument.UndoText, FallbackValue='Undo'}" Command="{Binding UndoCommand}"
                  IsEnabled="{Binding ActiveDocument.CanUndo, FallbackValue=False}"><Path Classes="icon" Data="{StaticResource IconUndo}" /></Button>
          <Button Classes="icon" ToolTip.Tip="{Binding ActiveDocument.RedoText, FallbackValue='Redo'}" Command="{Binding RedoCommand}"
                  IsEnabled="{Binding ActiveDocument.CanRedo, FallbackValue=False}"><Path Classes="icon" Data="{StaticResource IconRedo}" /></Button>
        </StackPanel>

        <TextBlock Grid.Column="1" Text="{Binding WindowTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />

        <StackPanel x:Name="TitleRight" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
          <Border Background="{DynamicResource St.Window}" CornerRadius="7" Padding="2" IsEnabled="{Binding HasDocument}">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ToggleButton Classes="segment" Content="Strayta" IsChecked="{Binding IsStraytaView}" ToolTip.Tip="Strayta's render" />
              <ToggleButton Classes="segment" Content="Photoshop" IsChecked="{Binding IsPhotoshopView}" ToolTip.Tip="The image stored in the file" />
              <ToggleButton Classes="segment" Content="Difference" IsChecked="{Binding IsDifferenceView}" ToolTip.Tip="Pixels that differ, in red" />
            </StackPanel>
          </Border>
          <Button Classes="icon" ToolTip.Tip="Fit on screen (⌘0)" Command="{Binding FitCommand}"><Path Classes="icon" Data="{StaticResource IconFit}" /></Button>
          <Button Classes="icon" ToolTip.Tip="Switch light / dark" Command="{Binding ToggleAppearanceCommand}">
            <Panel>
              <Path Classes="icon" Data="{StaticResource IconSun}" IsVisible="{Binding !IsLightAppearance}" />
              <Path Classes="icon" Data="{StaticResource IconMoon}" IsVisible="{Binding IsLightAppearance}" />
            </Panel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Shows the native menu inside the window on platforms without a global menu bar (Windows, Linux). -->
    <NativeMenuBar DockPanel.Dock="Top" />

    <!-- Options bar: settings for the current tool -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource St.Panel}" Height="36" Padding="12,0"
            BorderBrush="{DynamicResource St.Border}" BorderThickness="0,0,0,1">
      <Panel>
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" IsVisible="{Binding !IsTransforming}">
        <TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="52" />

        <TextBlock Classes="label" Text="Drag to move the selected layer · Space or middle button pans · wheel zooms"
                   IsVisible="{Binding IsMoveTool}" />
        <TextBlock Classes="label" Text="Drag to pan · wheel zooms" IsVisible="{Binding IsHandTool}" />
        <TextBlock Classes="label" IsVisible="{Binding IsMarqueeTool}"
                   Text="Drag to select · Shift adds (or makes it square) · Option subtracts, or draws from the center · Shift+Option intersects · click to deselect" />
        <TextBlock Classes="label" IsVisible="{Binding IsLassoTool}"
                   Text="Drag around an area to select it · Shift adds · Option subtracts · Shift+Option intersects · click to deselect" />

        <!-- Magic Wand and Quick Selection -->
        <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding IsMagicWandTool}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="label" Text="Tolerance" />
            <c:NumberField Value="{Binding WandTolerance}" Width="44" ToolTip.Tip="How different a color may be from the clicked one, 0–255 per channel" />
          </StackPanel>
          <CheckBox Content="Anti-alias" IsChecked="{Binding WandAntiAlias}" FontSize="11" />
          <CheckBox Content="Contiguous" IsChecked="{Binding WandContiguous}" FontSize="11" ToolTip.Tip="Only areas connected to the clicked pixel" />
          <CheckBox Content="Sample All Layers" IsChecked="{Binding WandSampleAllLayers}" FontSize="11" ToolTip.Tip="Look at the whole image instead of the selected layer" />
          <TextBlock Classes="label" Text="Click to select similar colors · Shift adds · Option subtracts · Shift+Option intersects" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding IsQuickSelectTool}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="label" Text="Size" />
            <Slider Width="110" Minimum="1" Maximum="500" Value="{Binding QuickSelectSize}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding QuickSelectSize, StringFormat='{}{0:0} px'}" VerticalAlignment="Center" MinWidth="44" />
          </StackPanel>
          <CheckBox Content="Sample All Layers" IsChecked="{Binding QuickSelectSampleAllLayers}" FontSize="11" ToolTip.Tip="Look at the whole image instead of the selected layer" />
          <CheckBox Content="Auto-Enhance" IsChecked="{Binding QuickSelectAutoEnhance}" FontSize="11" ToolTip.Tip="Smoother, softer selection edges" />
          <CheckBox Content="Object-Aware" IsChecked="{Binding QuickSelectObjectAware}" IsEnabled="{Binding HasObjectModel}" FontSize="11"
                    ToolTip.Tip="{Binding QuickSelectObjectAwareTip}" ToolTip.ShowOnDisabled="True" />
          <TextBlock Classes="label" Text="Paint over an area to select it · adds to the selection · Option subtracts · ⌘D starts over" />
        </StackPanel>
        <!-- Object Selection: sample source, Select Subject, and how to get the models when they are missing -->
        <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding IsObjectSelectTool}">
          <CheckBox Content="Sample All Layers" IsChecked="{Binding ObjectSampleAllLayers}" VerticalAlignment="Center"
                    ToolTip.Tip="Look at the whole image; off looks only at the selected layer" />
          <Button Content="Select Subject" Command="{Binding SelectSubjectCommand}" IsEnabled="{Binding HasSelectionModels}"
                  VerticalAlignment="Center" ToolTip.Tip="Select the main subject of the image (Select › Subject)" />
          <TextBlock Classes="label" IsVisible="{Binding HasSelectionModels}"
                     Text="Drag a box around an object, or click it · Shift adds · Option subtracts · runs on this computer" />
          <TextBlock Classes="label" IsVisible="{Binding !HasSelectionModels}" Foreground="{DynamicResource St.Warning}"
                     Text="{Binding SelectionModelsHint}" TextTrimming="CharacterEllipsis" MaxWidth="900" />
        </StackPanel>

        <v:EverydayToolOptions /> <!-- Eyedropper, Paint Bucket, Gradient, Zoom -->
        <v:CropOptionsBar IsVisible="{Binding IsCropTool}" />

        <StackPanel Orientation="Horizontal" Spacing="18" IsVisible="{Binding IsPaintTool}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="label" Text="Size" />
            <Slider Width="130" Minimum="1" Maximum="500" Value="{Binding BrushSize}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BrushSize, StringFormat='{}{0:0} px'}" VerticalAlignment="Center" MinWidth="44" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="label" Text="Hardness" />
            <Slider Width="100" Minimum="0" Maximum="100" Value="{Binding BrushHardness}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BrushHardness, StringFormat='{}{0:0}%'}" VerticalAlignment="Center" MinWidth="34" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="label" Text="Opacity" />
            <Slider Width="100" Minimum="1" Maximum="100" Value="{Binding BrushOpacity}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BrushOpacity, StringFormat='{}{0:0}%'}" VerticalAlignment="Center" MinWidth="34" />
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!-- Free Transform: the box's reference point, size, angle; Enter/✓ applies, Esc/✕ cancels -->
      <DockPanel IsVisible="{Binding IsTransforming}">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="icon" ToolTip.Tip="Cancel transform (Esc)" Command="{Binding CancelTransformCommand}">
            <Path Classes="icon" Data="{StaticResource IconCancel}" />
          </Button>
          <Button Classes="icon" ToolTip.Tip="Commit transform (Enter)" Command="{Binding CommitTransformCommand}">
            <Path Classes="icon" Data="{StaticResource IconCommit}" Stroke="{DynamicResource St.Accent}" />
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Free Transform" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Classes="label" Text="X" />
          <c:NumberField Unit=" px" Value="{Binding ActiveDocument.FreeTransform.X, FallbackValue=0}" ToolTip.Tip="Horizontal position of the center" />
          <TextBlock Classes="label" Text="Y" />
          <c:NumberField Unit=" px" Value="{Binding ActiveDocument.FreeTransform.Y, FallbackValue=0}" ToolTip.Tip="Vertical position of the center" />
          <TextBlock Classes="label" Text="W" Margin="8,0,0,0" />
          <c:NumberField Unit="%" Value="{Binding ActiveDocument.FreeTransform.WidthPercent, FallbackValue=100}" ToolTip.Tip="Width" />
          <TextBlock Classes="label" Text="H" />
          <c:NumberField Unit="%" Value="{Binding ActiveDocument.FreeTransform.HeightPercent, FallbackValue=100}" ToolTip.Tip="Height" />
          <TextBlock Classes="label" Text="Angle" Margin="8,0,0,0" />
          <c:NumberField Unit="°" Value="{Binding ActiveDocument.FreeTransform.Angle, FallbackValue=0}" ToolTip.Tip="Rotation, clockwise" />
          <TextBlock Classes="label" Margin="12,0,0,0"
                     Text="Drag a corner to scale (Shift: free, Option: from center) · outside to rotate · inside to move" />
        </StackPanel>
      </DockPanel>
      </Panel>
    </Border>

    <!-- Tool strip -->
    <Border DockPanel.Dock="Left" Width="46" Background="{DynamicResource St.Panel}"
            BorderBrush="{DynamicResource St.Border}" BorderThickness="0,0,1,0" ZIndex="1"
            BoxShadow="2 0 6 0 #30000000">
      <DockPanel Margin="0,8">
        <!-- Foreground / background colors (X swaps, D resets) -->
        <Panel DockPanel.Dock="Bottom" Width="36" Height="36" HorizontalAlignment="Center">
          <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0" BorderThickness="0" Background="Transparent"
                  ToolTip.Tip="Background color">
            <Border Width="20" Height="20" CornerRadius="4" Background="{Binding BackgroundBrush}"
                    BorderBrush="{DynamicResource St.Border}" BorderThickness="1" />
            <Button.Flyout>
              <Flyout Placement="RightEdgeAlignedBottom">
                <ColorView Color="{Binding BackgroundColor}" IsAlphaVisible="False" Width="300" />
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button HorizontalAlignment="Left" VerticalAlignment="Top" Padding="0" BorderThickness="0" Background="Transparent"
                  ToolTip.Tip="Foreground (brush) color · X swaps · D resets">
            <Border Width="20" Height="20" CornerRadius="4" Background="{Binding ForegroundBrush}"
                    BorderBrush="{DynamicResource St.Border}" BorderThickness="1" BoxShadow="0 1 3 0 #60000000" />
            <Button.Flyout>
              <Flyout Placement="RightEdgeAlignedBottom">
                <ColorView Color="{Binding ForegroundColor}" IsAlphaVisible="False" Width="300" />
              </Flyout>
            </Button.Flyout>
          </Button>
        </Panel>
        <!-- Tool slots (EditorViewModel.ToolGroups): related tools share a slot, as in Photoshop. The corner triangle
             marks a slot with more tools; press and hold or right-click it for the list. -->
        <ItemsControl ItemsSource="{Binding ToolGroups}" HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ToolGroup">
              <c:ToolSlot Classes="icon" IsChecked="{Binding IsActive, Mode=OneWay}" ToolTip.Tip="{Binding Tip}">
                <Panel>
                  <Path Classes="icon" Data="{Binding Current.Icon, Converter={x:Static c:ResourceIcon.Instance}}" />
                  <Path Classes="slotMore" IsVisible="{Binding HasMore}" Data="M4,0 L4,4 L0,4 Z" />
                </Panel>
              </c:ToolSlot>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <Panel>
      <dock:DockControl x:Name="Dock" />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="{Binding !HasDocument}">
        <TextBlock Text="Open a Photoshop file or start a new one" Classes="muted" FontSize="14" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Content="New…" Command="{Binding NewDocumentCommand}" />
          <Button Content="Open…" Command="{Binding OpenCommand}" />
        </StackPanel>
      </StackPanel>
    </Panel>
  </DockPanel>
</Window>
