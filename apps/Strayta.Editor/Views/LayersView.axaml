<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Strayta.Editor.ViewModels"
             xmlns:c="using:Strayta.Editor.Controls"
             xmlns:core="using:Strayta.Core"
             x:Class="Strayta.Editor.Views.LayersView"
             x:DataType="vm:LayersToolViewModel"
             Background="{DynamicResource St.Panel}"
             FontSize="11">
  <UserControl.Styles>
    <!-- Photoshop-like rows: full-width, separated by hairlines, neutral selection -->
    <Style Selector="ListBox#Rows">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox#Rows ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="BorderBrush" Value="{DynamicResource St.RowLine}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ListBox#Rows ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource St.Hover}" />
    </Style>
    <Style Selector="ListBox#Rows ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource St.RowSelected}" />
    </Style>
    <Style Selector="ToggleButton.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ToggleButton.flat:checked /template/ ContentPresenter, ToggleButton.flat:unchecked /template/ ContentPresenter, ToggleButton.flat:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.eye:unchecked Path.icon">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ToggleButton.lock:unchecked Path.icon">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="ToggleButton.lock:checked Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource St.Accent}" />
    </Style>
    <Style Selector="Border.eye">
      <Setter Property="Background" Value="{DynamicResource St.EyeCell}" />
      <Setter Property="BorderBrush" Value="{DynamicResource St.Border}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.eye:pointerover">
      <Setter Property="Background" Value="{DynamicResource St.EyeCellHover}" />
    </Style>
    <Style Selector="Border.thumb">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="27" />
      <Setter Property="BorderBrush" Value="{DynamicResource St.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource St.ThumbBackground}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- Photoshop frames whichever thumbnail (layer or mask) painting edits -->
    <Style Selector="Border.thumb.target">
      <Setter Property="BorderBrush" Value="{DynamicResource St.Text}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Blending and locks for the selected layer -->
    <Border DockPanel.Dock="Top" Padding="8,5,8,4" Background="{DynamicResource St.PanelRaised}"
            BorderBrush="{DynamicResource St.Border}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="3" DataContext="{Binding Editor.ActiveDocument.SelectedLayer}" x:DataType="vm:LayerItemViewModel"
                  IsEnabled="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
            <TextBlock Classes="label" Text="Opacity:" />
            <c:PercentField Value="{Binding Opacity}" />
          </StackPanel>
          <ComboBox x:Name="BlendCombo" ItemsSource="{Binding BlendModeChoices}" SelectedItem="{Binding BlendMode, Mode=OneWay}"
                    SelectionChanged="OnBlendChosen" HorizontalAlignment="Stretch" MinWidth="0"
                    MinHeight="22" Height="22" Padding="8,0" FontSize="11">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="core:BlendMode">
                <TextBlock Text="{Binding Converter={x:Static c:BlendModeNames.Instance}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </DockPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsGroup}">
            <TextBlock Classes="label" Text="Fill:" />
            <c:PercentField Value="{Binding Fill}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Classes="label" Text="Lock:" />
            <ToggleButton Classes="flat lock" IsChecked="{Binding TransparencyLocked}" IsEnabled="{Binding !IsGroup}"
                          ToolTip.Tip="Lock transparent pixels">
              <Path Classes="icon small" Data="{StaticResource IconChecker}" />
            </ToggleButton>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Footer actions -->
    <Border DockPanel.Dock="Bottom" Padding="6,3" BorderBrush="{DynamicResource St.Border}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="0">
          <Button Classes="icon" ToolTip.Tip="Add a layer style">
            <TextBlock Text="fx" FontStyle="Italic" FontWeight="SemiBold" FontSize="12" Margin="0,-2,0,0" />
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedLeft">
                <MenuItem Header="Blending Options…" Tag="BlendingOptions" Click="OnLayerStyleMenu" />
                <Separator />
                <MenuItem Header="Bevel &amp; Emboss…" Tag="BevelEmboss" Click="OnLayerStyleMenu" />
                <MenuItem Header="Stroke…" Tag="Stroke" Click="OnLayerStyleMenu" />
                <MenuItem Header="Inner Shadow…" Tag="InnerShadow" Click="OnLayerStyleMenu" />
                <MenuItem Header="Inner Glow…" Tag="InnerGlow" Click="OnLayerStyleMenu" />
                <MenuItem Header="Satin…" Tag="Satin" Click="OnLayerStyleMenu" />
                <MenuItem Header="Color Overlay…" Tag="ColorOverlay" Click="OnLayerStyleMenu" />
                <MenuItem Header="Gradient Overlay…" Tag="GradientOverlay" Click="OnLayerStyleMenu" />
                <MenuItem Header="Pattern Overlay…" Tag="PatternOverlay" Click="OnLayerStyleMenu" />
                <MenuItem Header="Outer Glow…" Tag="OuterGlow" Click="OnLayerStyleMenu" />
                <MenuItem Header="Drop Shadow…" Tag="DropShadow" Click="OnLayerStyleMenu" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="MaskButton" Classes="icon" ToolTip.Tip="Add layer mask (reveals the selection, if any; Option hides it)" Command="{Binding Editor.AddLayerMaskCommand}"><Path Classes="icon small" Data="{StaticResource IconMask}" /></Button>
          <Button Classes="icon" ToolTip.Tip="New adjustment layer">
            <Panel>
              <Path Classes="icon small" Data="{StaticResource IconAdjust}" />
              <Path Classes="icon small" Data="{StaticResource IconHalfDisc}" Fill="{DynamicResource St.Text}" />
            </Panel>
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedLeft">
                <MenuItem Header="Brightness/Contrast…" Tag="Brightness/Contrast" Click="OnNewAdjustment" />
                <MenuItem Header="Levels…" Tag="Levels" Click="OnNewAdjustment" />
                <MenuItem Header="Curves…" Tag="Curves" Click="OnNewAdjustment" />
                <MenuItem Header="Exposure…" Tag="Exposure" Click="OnNewAdjustment" />
                <Separator />
                <MenuItem Header="Vibrance…" Tag="Vibrance" Click="OnNewAdjustment" />
                <MenuItem Header="Hue/Saturation…" Tag="Hue/Saturation" Click="OnNewAdjustment" />
                <MenuItem Header="Color Balance…" Tag="Color Balance" Click="OnNewAdjustment" />
                <MenuItem Header="Black &amp; White…" Tag="Black &amp; White" Click="OnNewAdjustment" />
                <MenuItem Header="Photo Filter…" Tag="Photo Filter" Click="OnNewAdjustment" />
                <MenuItem Header="Channel Mixer…" Tag="Channel Mixer" Click="OnNewAdjustment" />
                <MenuItem Header="Color Lookup…" Tag="Color Lookup" Click="OnNewAdjustment" />
                <Separator />
                <MenuItem Header="Invert" Tag="Invert" Click="OnNewAdjustment" />
                <MenuItem Header="Posterize…" Tag="Posterize" Click="OnNewAdjustment" />
                <MenuItem Header="Threshold…" Tag="Threshold" Click="OnNewAdjustment" />
                <MenuItem Header="Gradient Map…" Tag="Gradient Map" Click="OnNewAdjustment" />
                <MenuItem Header="Selective Color…" Tag="Selective Color" Click="OnNewAdjustment" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="icon" ToolTip.Tip="New group (⌘G)" Command="{Binding Editor.NewGroupCommand}"><Path Classes="icon small" Data="{StaticResource IconFolder}" /></Button>
          <Button Classes="icon" ToolTip.Tip="New layer (⇧⌘N)" Command="{Binding Editor.NewLayerCommand}"><Path Classes="icon small" Data="{StaticResource IconNewLayer}" /></Button>
          <Button Classes="icon" ToolTip.Tip="Delete layer" Command="{Binding Editor.DeleteLayerCommand}"><Path Classes="icon small" Data="{StaticResource IconTrash}" /></Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Background="Transparent"
                    IsVisible="{Binding Editor.ActiveDocument.HasWarnings, FallbackValue=False}"
                    ToolTip.Tip="{Binding Editor.ActiveDocument.WarningsText, FallbackValue=''}">
          <Path Classes="icon small" Data="{StaticResource IconWarning}" Stroke="{DynamicResource St.Warning}" />
          <TextBlock Text="{Binding Editor.ActiveDocument.Warnings.Count, StringFormat='{}{0} not rendered', FallbackValue=''}"
                     Foreground="{DynamicResource St.Warning}" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <TextBlock DockPanel.Dock="Top" Text="No document open" Margin="12" Classes="muted" IsVisible="{Binding !Editor.HasDocument}" />
    <Panel>
      <ListBox x:Name="Rows" ItemsSource="{Binding Editor.ActiveDocument.Rows}"
               SelectedItem="{Binding Editor.ActiveDocument.SelectedLayer, Mode=TwoWay}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LayerItemViewModel">
            <StackPanel>
            <Grid ColumnDefinitions="30,*" Height="34" Background="Transparent" DoubleTapped="OnRowDoubleTapped">
              <!-- Eye column: its own button-like cell, fixed at the left edge like Photoshop -->
              <Border Classes="hit eye" PointerPressed="OnEyePressed" ToolTip.Tip="Show or hide">
                <Path Classes="icon small" Data="{StaticResource IconEye}" Opacity="{Binding EyeOpacity}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>

              <DockPanel Grid.Column="1" Margin="{Binding Indent}">
                <!-- Group disclosure -->
                <Border DockPanel.Dock="Left" Classes="hit" Width="22" Background="Transparent" IsVisible="{Binding IsGroup}"
                        PointerPressed="OnChevronPressed">
                  <Path Classes="icon small" Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="{Binding IsExpanded, Converter={x:Static vm:Disclosure.Instance}}" />
                </Border>

                <!-- Thumbnail, or an icon for groups and adjustments -->
                <Panel DockPanel.Dock="Left" Margin="6,0,0,0" VerticalAlignment="Center">
                  <Border Classes="thumb" Classes.target="{Binding IsPixelTarget}" PointerPressed="OnLayerThumbPressed"
                          IsVisible="{Binding PlaceholderIcon, Converter={x:Static ObjectConverters.IsNull}}">
                    <Panel>
                      <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
                      <Border IsVisible="{Binding IsSmartObject}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Background="{DynamicResource St.Panel}" CornerRadius="2,0,0,0" Padding="1">
                        <Path Classes="icon" Width="9" Height="9" StrokeThickness="1.2" Data="{StaticResource IconNew}" />
                      </Border>
                    </Panel>
                  </Border>
                  <Path Classes="icon" Width="17" Height="17" Stroke="{DynamicResource St.TextMuted}" Data="{Binding PlaceholderIcon}"
                        IsVisible="{Binding PlaceholderIcon, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="8,0" />
                </Panel>

                <!-- Link + mask thumbnail -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" IsVisible="{Binding HasMask}" VerticalAlignment="Center">
                  <Path Classes="icon small" Width="10" Height="12" Margin="4,0" Stroke="{DynamicResource St.TextMuted}" Data="{StaticResource IconLink}" />
                  <Border Classes="thumb" Classes.target="{Binding IsMaskTarget}" PointerPressed="OnMaskThumbPressed"
                          ToolTip.Tip="Layer mask: click to paint in it, Shift-click to disable or enable it">
                    <Panel>
                      <Image Source="{Binding MaskThumbnail}" Stretch="Uniform" />
                      <Path IsVisible="{Binding MaskDisabled}" Data="M0 0L24 24 M24 0L0 24" Stretch="Fill" Margin="2"
                            Stroke="#FFE5484D" StrokeThickness="2" />
                    </Panel>
                  </Border>
                </StackPanel>

                <!-- Markers on the right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                  <!-- fx badge: click shows or hides the effect rows, double-click opens Layer Style (LayersView.LayerStyle.cs) -->
                  <Border Classes="hit" Background="Transparent" IsVisible="{Binding HasEffects}" PointerPressed="OnFxPressed"
                          DoubleTapped="OnFxDoubleTapped" ToolTip.Tip="Layer style: click to list the effects, double-click to edit">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <TextBlock Text="fx" FontStyle="Italic" FontWeight="SemiBold" Classes="muted" VerticalAlignment="Center" />
                      <Path Classes="icon small" Width="8" Height="8" VerticalAlignment="Center"
                            Data="{Binding EffectsExpanded, Converter={x:Static vm:Disclosure.Instance}}" />
                    </StackPanel>
                  </Border>
                  <Path Classes="icon small" Data="{StaticResource IconWarning}" IsVisible="{Binding HasUnsupported}" Stroke="{DynamicResource St.Warning}"
                        ToolTip.Tip="Uses effects or adjustments that are not rendered yet" />
                  <Path Classes="icon small" Data="{StaticResource IconLock}" IsVisible="{Binding IsLocked}" Stroke="{DynamicResource St.TextMuted}"
                        ToolTip.Tip="Transparent pixels locked" />
                </StackPanel>

                <!-- Name (double-click to rename) -->
                <Panel VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock IsVisible="{Binding !IsRenaming}" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                             Background="Transparent" DoubleTapped="OnNameDoubleTapped" />
                  <TextBox IsVisible="{Binding IsRenaming}" Text="{Binding Name, Mode=OneWay}" Padding="4,1" MinHeight="0"
                           KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus" AttachedToVisualTree="OnRenameAttached" />
                </Panel>
              </DockPanel>
            </Grid>
            <!-- The layer's effects, each with its eye, as in Photoshop -->
            <ItemsControl ItemsSource="{Binding EffectRows}" IsVisible="{Binding ShowEffectRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EffectRowViewModel">
                  <Grid ColumnDefinitions="30,20,*" Height="20">
                    <Border Classes="hit eye" PointerPressed="OnEffectEyePressed" ToolTip.Tip="Show or hide">
                      <Path Classes="icon small" Width="11" Height="11" Data="{StaticResource IconEye}" Opacity="{Binding EyeOpacity}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- Opens this effect's page in Layer Style with a single click (double-clicking the name does too) -->
                    <Border Grid.Column="1" Classes="hit" Background="Transparent" PointerPressed="OnEffectEditPressed"
                            ToolTip.Tip="Edit in Layer Style">
                      <Path Classes="icon small" Width="11" Height="11" Data="{StaticResource IconSliders}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="{Binding Indent}" VerticalAlignment="Center"
                               Classes="muted" TextTrimming="CharacterEllipsis" Background="Transparent" DoubleTapped="OnFxDoubleTapped" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Drop indicator for drag-and-drop reordering -->
      <Canvas IsHitTestVisible="False">
        <Border x:Name="DropLine" Height="2" Background="{DynamicResource St.Accent}" IsVisible="False" />
        <Border x:Name="DropBox" BorderBrush="{DynamicResource St.Accent}" BorderThickness="2" IsVisible="False" />
      </Canvas>
    </Panel>
  </DockPanel>
</UserControl>
