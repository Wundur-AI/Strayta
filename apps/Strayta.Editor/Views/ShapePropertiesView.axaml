<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Strayta.Editor.ViewModels"
             xmlns:c="using:Strayta.Editor.Controls"
             x:Class="Strayta.Editor.Views.ShapePropertiesView"
             x:DataType="vm:ShapePanel">
  <!-- The Properties panel's Live Shape section (ShapePanel.cs) -->
  <StackPanel Spacing="8">
    <Separator Margin="0,4" />
    <StackPanel Orientation="Horizontal" Spacing="6">
      <TextBlock Classes="label" Text="Live Shape" />
      <TextBlock Classes="muted" Text="{Binding Kind}" />
    </StackPanel>
    <Grid ColumnDefinitions="Auto,Auto,12,Auto,Auto" RowDefinitions="Auto,6,Auto">
      <TextBlock Classes="label" Text="W" VerticalAlignment="Center" Margin="0,0,6,0" />
      <c:NumberField Grid.Column="1" Unit=" px" Value="{Binding W}" Width="76" ToolTip.Tip="Width of the shape's outline" />
      <TextBlock Grid.Column="3" Classes="label" Text="H" VerticalAlignment="Center" Margin="0,0,6,0" />
      <c:NumberField Grid.Column="4" Unit=" px" Value="{Binding H}" Width="76" ToolTip.Tip="Height of the shape's outline" />
      <TextBlock Grid.Row="2" Classes="label" Text="X" VerticalAlignment="Center" Margin="0,0,6,0" />
      <c:NumberField Grid.Row="2" Grid.Column="1" Unit=" px" Value="{Binding X}" Width="76" ToolTip.Tip="Left edge of the outline" />
      <TextBlock Grid.Row="2" Grid.Column="3" Classes="label" Text="Y" VerticalAlignment="Center" Margin="0,0,6,0" />
      <c:NumberField Grid.Row="2" Grid.Column="4" Unit=" px" Value="{Binding Y}" Width="76" ToolTip.Tip="Top edge of the outline" />
    </Grid>

    <StackPanel Spacing="6" IsVisible="{Binding HasCorners}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Classes="label" Text="Corners" VerticalAlignment="Center" Width="52" />
        <c:NumberField Unit=" px" Value="{Binding Radius}" Width="70" IsVisible="{Binding LinkCorners}" ToolTip.Tip="Radius of every corner" />
        <ToggleButton Classes="icon" Padding="3" IsChecked="{Binding LinkCorners}" ToolTip.Tip="Link the corner radii">
          <Path Classes="icon small" Data="{StaticResource IconLink}" />
        </ToggleButton>
      </StackPanel>
      <Grid ColumnDefinitions="Auto,Auto,12,Auto,Auto" RowDefinitions="Auto,6,Auto" IsVisible="{Binding ShowSeparateCorners}">
        <TextBlock Classes="label" Text="┌" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="Top left" />
        <c:NumberField Grid.Column="1" Unit=" px" Value="{Binding TopLeft}" Width="70" ToolTip.Tip="Top-left corner radius" />
        <TextBlock Grid.Column="3" Classes="label" Text="┐" VerticalAlignment="Center" Margin="0,0,6,0" />
        <c:NumberField Grid.Column="4" Unit=" px" Value="{Binding TopRight}" Width="70" ToolTip.Tip="Top-right corner radius" />
        <TextBlock Grid.Row="2" Classes="label" Text="└" VerticalAlignment="Center" Margin="0,0,6,0" />
        <c:NumberField Grid.Row="2" Grid.Column="1" Unit=" px" Value="{Binding BottomLeft}" Width="70" ToolTip.Tip="Bottom-left corner radius" />
        <TextBlock Grid.Row="2" Grid.Column="3" Classes="label" Text="┘" VerticalAlignment="Center" Margin="0,0,6,0" />
        <c:NumberField Grid.Row="2" Grid.Column="4" Unit=" px" Value="{Binding BottomRight}" Width="70" ToolTip.Tip="Bottom-right corner radius" />
      </Grid>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Classes="label" Text="Fill" VerticalAlignment="Center" Width="52" />
      <Button Padding="0" BorderThickness="0" Background="Transparent" ToolTip.Tip="Fill color" IsEnabled="{Binding HasFillColor}">
        <Border Width="26" Height="18" CornerRadius="3" Background="{Binding FillBrush}" BorderBrush="{DynamicResource St.Border}" BorderThickness="1" />
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <ColorView Color="{Binding FillColor}" IsAlphaVisible="False" Width="300" />
          </Flyout>
        </Button.Flyout>
      </Button>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <CheckBox Content="Stroke" IsChecked="{Binding StrokeEnabled}" FontSize="11" Width="60" />
      <Button Padding="0" BorderThickness="0" Background="Transparent" ToolTip.Tip="Stroke color" IsEnabled="{Binding StrokeEnabled}">
        <Border Width="26" Height="18" CornerRadius="3" BorderBrush="{Binding StrokeBrush}" BorderThickness="4" />
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <ColorView Color="{Binding StrokeColor}" IsAlphaVisible="False" Width="300" />
          </Flyout>
        </Button.Flyout>
      </Button>
      <c:NumberField Unit=" px" Value="{Binding StrokeWidth}" Width="56" IsEnabled="{Binding StrokeEnabled}" ToolTip.Tip="Stroke width" />
      <ComboBox Classes="channel" Width="84" ItemsSource="{x:Static vm:ShapeOptions.AlignmentNames}" SelectedIndex="{Binding StrokeAlignmentIndex}"
                IsEnabled="{Binding StrokeEnabled}" ToolTip.Tip="Stroke alignment" />
    </StackPanel>
  </StackPanel>
</UserControl>
