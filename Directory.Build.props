<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Keep local machine paths (and user names) out of compiled PDBs. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>

    <!-- All packages version in lockstep until release cadences diverge. -->
    <Version>0.1.0</Version>
    <Authors>Strayta contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <!-- Exit code 8 means "zero tests ran"; allowed while a project is still empty (or has no performance tests). -->
    <!-- Timed tests (Trait Category=Performance) are left out of the normal run: sharing the CPU with every other test
         project makes them fail at random. `dotnet test -c Release -p:Performance=true` runs only them, one at a time. -->
    <TestingPlatformCommandLineArguments Condition="'$(Performance)' != 'true'">--ignore-exit-code 8 --filter-not-trait "Category=Performance"</TestingPlatformCommandLineArguments>
    <TestingPlatformCommandLineArguments Condition="'$(Performance)' == 'true'">--ignore-exit-code 8 --filter-trait "Category=Performance" --parallel none</TestingPlatformCommandLineArguments>
    <!-- Renders in tests are short and in-memory; threading xUnit's token through them adds noise. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
</Project>
