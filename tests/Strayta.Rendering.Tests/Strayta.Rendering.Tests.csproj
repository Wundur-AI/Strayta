<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <!-- Independent decoder for checking exported PNG/JPEG files (MIT; the version Avalonia ships). -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Strayta.Rendering\Strayta.Rendering.csproj" />
    <!-- Canvas operations are checked through a PSD round trip. -->
    <ProjectReference Include="..\..\src\Strayta.Psd\Strayta.Psd.csproj" />
    <!-- WebP export and sRGB conversion come from Imaging (SkiaSharp). -->
    <ProjectReference Include="..\..\src\Strayta.Imaging\Strayta.Imaging.csproj" />
  </ItemGroup>
</Project>
